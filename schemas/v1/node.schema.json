{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuaran.com/app-composition/v1/node.schema.json",
  "title": "Composition node — core kinds",
  "description": "APP_COMPOSITION_WIRE.md sections 3 and 5: the core node kinds. A profile-only kind (section 8.3) is declared, and given its schema, by the profile that declares it, published where section 8.5 says; a core-scope reader refuses one as node-kind-unknown, and so does this schema. STRUCTURAL ONLY and subordinate to the normative text. Three things this schema cannot express and the text can: member ORDER (section 4.2), the canonical byte encoding (section 4), and id uniqueness across the tree (section 3.2). This schema describes what a conformant WRITER emits: the accept vectors (an unknown member on a known kind, section 9.3) and the reject vectors are deliberately outside it.",

  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "children": { "type": "array", "items": { "$ref": "#" } },
    "profileToken": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "wireBool": { "type": "string", "enum": ["true", "false"] },
    "duration": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "disclosure": {
      "type": "object",
      "properties": {
        "class": { "$ref": "#/$defs/profileToken" },
        "policy": { "type": "string" }
      },
      "required": ["class"]
    },
    "factDefinition": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "integer" },
        "hierarchy": { "type": "string" },
        "level": { "type": "string" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": { "type": "string" },
              "shape": { "$ref": "#/$defs/profileToken" },
              "disclosure": { "$ref": "#/$defs/disclosure" }
            },
            "required": ["metric", "shape"]
          }
        },
        "periodGrain": { "$ref": "#/$defs/profileToken" },
        "producingOperation": { "type": "string" },
        "refreshCadenceSeconds": { "$ref": "#/$defs/duration" },
        "historyMode": { "$ref": "#/$defs/profileToken" },
        "disclosure": { "$ref": "#/$defs/disclosure" },
        "requirement": { "$ref": "#/$defs/profileToken" }
      },
      "required": [
        "schemaVersion",
        "hierarchy",
        "level",
        "columns",
        "periodGrain",
        "producingOperation",
        "refreshCadenceSeconds",
        "historyMode",
        "disclosure",
        "requirement"
      ]
    },
    "metricDefinition": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "dimensionality": { "type": "string" },
        "direction": { "$ref": "#/$defs/profileToken" },
        "displayFormat": { "type": "string" },
        "staleness": {
          "type": "object",
          "properties": {
            "policy": { "$ref": "#/$defs/profileToken" },
            "windowSeconds": { "$ref": "#/$defs/duration" }
          },
          "required": ["policy"]
        },
        "producingOperation": { "type": "string" },
        "canonicalMethod": { "type": "string" },
        "recomputePolicy": { "$ref": "#/$defs/profileToken" },
        "rollUp": {
          "type": "object",
          "properties": {
            "kind": { "$ref": "#/$defs/profileToken" },
            "tolerance": { "type": "string" }
          },
          "required": ["kind"]
        },
        "context": { "type": "string" }
      },
      "required": ["id", "name", "unit", "dimensionality", "direction", "displayFormat", "staleness"]
    },
    "subjectDefinition": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "levels": { "type": "array", "items": { "type": "string" } },
        "calendar": { "type": "string" }
      },
      "required": ["id", "name", "levels"]
    },
    "field": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "required": ["kind", "id"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "appRoot",
        "serverConfig",
        "companionSelection",
        "moduleRef",
        "dataType",
        "configKnob",
        "portAllocation",
        "connectorRef",
        "extensionRef"
      ]
    },
    "id": { "$ref": "#/$defs/id" },
    "children": { "$ref": "#/$defs/children" }
  },

  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "appRoot" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "base": { "$ref": "#/$defs/profileToken" },
          "layers": { "type": "array", "items": { "$ref": "#/$defs/profileToken" } },
          "displayName": {
            "type": "string",
            "pattern": "[^\\t\\n\\u000b\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
          },
          "shortName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
          "projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!\\.\\.?(?:/|$))(?!.*/\\.\\.?(?:/|$))[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+(?:/[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+)*$"
            }
          }
        },
        "required": ["base", "layers"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "serverConfig" } }, "required": ["kind"] },
      "then": true
    },
    {
      "if": { "properties": { "kind": { "const": "companionSelection" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "slot": { "$ref": "#/$defs/profileToken" },
          "impl": { "type": "string", "minLength": 1 }
        },
        "required": ["slot", "impl"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "moduleRef" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "view": { "$ref": "#/$defs/profileToken" },
          "viewSpec": { "$ref": "citation.schema.json" },
          "surfaceKind": { "type": "string", "enum": ["view", "webhook", "api"] },
          "factTables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "subjects": { "type": "array", "items": { "type": "string" } },
                "metrics": { "type": "array", "items": { "type": "string" } },
                "grains": { "type": "array", "items": { "$ref": "#/$defs/profileToken" } },
                "definition": { "$ref": "#/$defs/factDefinition" }
              },
              "required": ["id", "subjects", "metrics", "grains"]
            }
          },
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "disclosure": { "$ref": "#/$defs/disclosure" },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "fieldPath": { "type": "string" },
                      "level": { "$ref": "#/$defs/profileToken" },
                      "auditOnRead": { "$ref": "#/$defs/wireBool" },
                      "encryptionKeyId": { "type": "string" }
                    },
                    "required": ["fieldPath", "level", "auditOnRead"]
                  }
                }
              },
              "required": ["name", "disclosure"]
            }
          },
          "aiExposure": { "$ref": "#/$defs/profileToken" },
          "disclosurePolicies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "policyRef": { "type": "string" },
                "mode": { "$ref": "#/$defs/profileToken" },
                "permitSurfaces": { "type": "array", "items": { "$ref": "#/$defs/profileToken" } },
                "contributorScope": { "type": "string" }
              },
              "required": ["policyRef", "mode", "permitSurfaces"]
            }
          },
          "bodyAddress": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["view"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "dataType" } }, "required": ["kind"] },
      "then": {
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "configKnob" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "required": ["key", "value"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "portAllocation" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "server": { "$ref": "#/$defs/port" },
          "client": { "$ref": "#/$defs/port" }
        },
        "required": ["server"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "connectorRef" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "impl": { "type": "string", "minLength": 1 },
          "oauth": { "type": "string", "enum": ["noOAuth", "oauth1a", "oauth2"] },
          "rateLimited": { "$ref": "#/$defs/wireBool" }
        },
        "required": ["impl", "oauth", "rateLimited"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "extensionRef" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "extensionKind": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
          "children": { "type": "array", "maxItems": 0 }
        },
        "required": ["namespace", "extensionKind", "fields"]
      }
    }
  ],

  "unevaluatedProperties": false
}
